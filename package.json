{
  "name": "@tokennotincluded/dsh-lmm-provider",
  "version": "0.1.0-alpha.1",
  "description": "LMM browser OAuth and account-scoped model provider for DeepSeek Harness",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "TokenNotIncluded",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokenNotIncluded/dsh-lmm-provider.git"
  },
  "homepage": "https://github.com/TokenNotIncluded/dsh-lmm-provider#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "oauth",
    "lmm",
    "model-provider"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "plugin": {
      "schemaVersion": 1,
      "displayName": {
        "zh-CN": "LMM 模型",
        "en": "LMM Models"
      },
      "summary": {
        "zh-CN": "通过浏览器 OAuth 登录 LMM，并在 DSH 中使用账户可用的模型。",
        "en": "Sign in to LMM with browser OAuth and use account-scoped models in DSH."
      },
      "category": "model-provider"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --out-dir lib --clean",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm run build && npm pack --dry-run --ignore-scripts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@earendil-works/pi-ai": "^0.85.1",
    "@deepseek-ai/dsh-home-paths": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.5-rc.1",
    "typebox": "^1.3.30"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-attachment": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-authorization": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-launch-environment": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.1.5-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.1",
    "@deepseek-ai/dsh-authorization": "0.1.5-rc.1",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-timeout": "0.1.5-rc.1",
    "@types/node": "^22.19.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
